{
  "contract": "morphogen.organism.v1",
  "key": "organism:lookup",
  "name": "Tool-call document lookup",
  "note": "An agent cell answers a question about a document, reaching back into the automaton through a declared pick.v1 tool call.",
  "budgets": {
    "maxSteps": 16,
    "maxAgentCalls": 8,
    "maxWork": 100000
  },
  "interface": {
    "inputs": {
      "doc": { "cell": "input", "port": "doc" },
      "q": { "cell": "input", "port": "q" }
    },
    "outputs": {
      "answer": { "cell": "reader", "port": "out" }
    }
  },
  "cells": [
    {
      "id": "input",
      "kind": "input",
      "outputs": { "doc": "json", "q": "text" }
    },
    {
      "id": "reader",
      "kind": "agent",
      "inputs": { "doc": "json", "q": "text" },
      "prompt": "Answer the question about the document. Use pick.v1 to read document fields, then answer in one sentence.",
      "view": { "inputs": "*" },
      "output": { "kind": "text" },
      "tools": ["pick.v1"],
      "budget": { "maxTurns": 4, "maxContextBytes": 8192 }
    }
  ],
  "edges": [
    { "from": { "cell": "input", "port": "doc" }, "to": { "cell": "reader", "port": "doc" } },
    { "from": { "cell": "input", "port": "q" }, "to": { "cell": "reader", "port": "q" } }
  ]
}
