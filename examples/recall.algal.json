{
  "contract": "algal.organism.v1",
  "key": "organism:recall",
  "name": "Recorded semantic recall and rerank",
  "cells": [
    { "id": "src", "kind": "input", "outputs": { "query": "text", "doc-a": "json", "doc-b": "json" } },
    { "id": "pin-a", "kind": "store" },
    { "id": "pin-b", "kind": "store" },
    {
      "id": "memory",
      "kind": "recall",
      "inputs": { "query": "text" },
      "query": {
        "contract": "algal.expr.v1",
        "program": ["sconcat", ["get", "query"], " habitat"]
      },
      "k": 2,
      "embedder": "local",
      "rerank": { "route": { "provider": "scripted" }, "take": 1 }
    },
    { "id": "full", "kind": "load" }
  ],
  "edges": [
    { "from": { "cell": "src", "port": "doc-a" }, "to": { "cell": "pin-a", "port": "data" } },
    { "from": { "cell": "src", "port": "doc-b" }, "to": { "cell": "pin-b", "port": "data" } },
    { "from": { "cell": "src", "port": "query" }, "to": { "cell": "memory", "port": "query" } },
    { "from": { "cell": "memory", "port": "ref" }, "to": { "cell": "full", "port": "ref" } }
  ]
}
