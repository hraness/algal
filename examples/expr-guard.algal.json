{
  "contract": "algal.organism.v1",
  "key": "organism:expr-guard",
  "name": "Expr guard",
  "cells": [
    { "id": "in", "kind": "input", "outputs": { "n": "json" } },
    {
      "id": "calc",
      "kind": "expr",
      "inputs": { "n": "json" },
      "expr": {
        "contract": "algal.expr.v1",
        "program": ["mul", ["get", "n"], 2]
      },
      "output": { "kind": "json", "schema": { "type": "number" } }
    },
    { "id": "sink", "kind": "fn", "fn": "echo.v1" }
  ],
  "edges": [
    {
      "from": { "cell": "in", "port": "n" },
      "to": { "cell": "calc", "port": "n" }
    },
    {
      "from": { "cell": "calc", "port": "out" },
      "to": { "cell": "sink", "port": "value" },
      "guard": {
        "expr": {
          "contract": "algal.expr.v1",
          "program": ["gt", ["get", "value"], 100]
        }
      }
    }
  ]
}
