{
  "contract": "algal.organism.v1",
  "key": "organism:gen-one",
  "name": "GenOne",
  "interface": {
    "inputs": {
      "task": { "cell": "src", "port": "task" },
      "feedback": { "cell": "prev", "port": "fb" }
    },
    "outputs": {
      "score": { "cell": "judge", "port": "out" },
      "child": { "cell": "run", "port": "digest" },
      "result": { "cell": "run", "port": "data" }
    }
  },
  "cells": [
    { "id": "src", "kind": "input", "outputs": { "task": "text" } },
    { "id": "prev", "kind": "input", "outputs": { "fb": "text" } },
    {
      "id": "writer",
      "kind": "agent",
      "inputs": {
        "task": "text",
        "feedback": { "type": "text", "optional": true }
      },
      "prompt": "Write an organism manifest; improve on the feedback.",
      "output": { "kind": "json", "schema": { "type": "object" } }
    },
    {
      "id": "args",
      "kind": "const",
      "outputs": { "a": { "type": "json", "value": { "q": "ping" } } }
    },
    { "id": "run", "kind": "spawn" },
    {
      "id": "judge",
      "kind": "classifier",
      "inputs": { "data": "json" },
      "prompt": "Score the child output.",
      "output": { "kind": "choice", "labels": ["good", "bad"], "onMiss": "bad" }
    }
  ],
  "edges": [
    { "from": { "cell": "src", "port": "task" }, "to": { "cell": "writer", "port": "task" } },
    { "from": { "cell": "prev", "port": "fb" }, "to": { "cell": "writer", "port": "feedback" } },
    { "from": { "cell": "writer", "port": "out" }, "to": { "cell": "run", "port": "manifest" } },
    { "from": { "cell": "args", "port": "a" }, "to": { "cell": "run", "port": "args" } },
    { "from": { "cell": "run", "port": "data" }, "to": { "cell": "judge", "port": "data" } }
  ]
}
