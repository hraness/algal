// Both imports leave this project's directory, so load it with the parent
// directory as the source root: --source-root examples/source/projects.
import score_task from "../task-planning/score_task.algal"
import clamp from "../task-planning/lib/clamp.algal"

program triage_ticket(ticket: json, weights: json, window: json) -> json {
  budget { max_agent_calls: 0, max_depth: 2 }

  let priority = call score_task using { task: ticket, weights: weights }
  let hours_left = call clamp
    using { value: window - ticket.hours_open, minimum: 0, maximum: window }
  let queue = if hours_left == 0 { "overdue" } else {
    if priority >= 10 { "urgent" } else { "standard" }
  }
  return {
    id: ticket.id,
    subject: ticket.subject,
    priority: priority,
    hours_left: hours_left,
    queue: queue,
  }
}
