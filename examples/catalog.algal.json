{
  "contract": "algal.organism.v1",
  "key": "organism:catalog",
  "name": "Catalog",
  "cells": [
    { "id": "src", "kind": "input", "outputs": { "task": "text" } },
    {
      "id": "writer",
      "kind": "agent",
      "inputs": { "task": "text" },
      "prompt": "Emit candidate organism manifests under manifests.",
      "output": {
        "kind": "json",
        "schema": {
          "type": "object",
          "required": ["manifests"],
          "properties": { "manifests": { "type": "array" } }
        }
      }
    },
    {
      "id": "field",
      "kind": "const",
      "outputs": { "f": { "type": "text", "value": "manifests" } }
    },
    { "id": "list", "kind": "fn", "fn": "pick.v1" },
    {
      "id": "swarm",
      "kind": "each",
      "manifest": "sha256:629887f96a96fd75569bc49d2c3a7c2feb905f577a027685dc21c7ebf9b51239",
      "over": "m",
      "maxItems": 4
    },
    {
      "id": "log",
      "kind": "slot",
      "name": "bred",
      "mode": "read",
      "default": []
    },
    { "id": "acc", "kind": "fn", "fn": "push.v1" },
    { "id": "sink", "kind": "slot", "name": "bred", "mode": "write" }
  ],
  "edges": [
    { "from": { "cell": "src", "port": "task" }, "to": { "cell": "writer", "port": "task" } },
    { "from": { "cell": "writer", "port": "out" }, "to": { "cell": "list", "port": "record" } },
    { "from": { "cell": "field", "port": "f" }, "to": { "cell": "list", "port": "field" } },
    { "from": { "cell": "list", "port": "value" }, "to": { "cell": "swarm", "port": "m" } },
    { "from": { "cell": "log", "port": "data" }, "to": { "cell": "acc", "port": "list" } },
    { "from": { "cell": "swarm", "port": "child" }, "to": { "cell": "acc", "port": "item" } },
    { "from": { "cell": "acc", "port": "value" }, "to": { "cell": "sink", "port": "data" } }
  ]
}
