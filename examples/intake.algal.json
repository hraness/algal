{
  "contract": "algal.organism.v1",
  "key": "organism:intake",
  "name": "Intake",
  "cells": [
    {
      "id": "src",
      "kind": "input",
      "outputs": {
        "ticket": {
          "type": "json",
          "schema": {
            "type": "object",
            "required": ["severity", "title"],
            "properties": {
              "severity": { "type": "string" },
              "title": { "type": "string" },
              "body": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "id": "handler",
      "kind": "agent",
      "inputs": { "ticket": "json" },
      "prompt": "Acknowledge the ticket in one line.",
      "output": { "kind": "text" }
    },
    {
      "id": "repair",
      "kind": "agent",
      "inputs": { "err": "json" },
      "prompt": "The ticket failed contract validation; ask for the missing fields.",
      "output": { "kind": "text" }
    }
  ],
  "edges": [
    { "from": { "cell": "src", "port": "ticket" }, "to": { "cell": "handler", "port": "ticket" } },
    { "from": { "cell": "src", "port": "ticket" }, "to": { "cell": "repair", "port": "err" }, "on": "fail" }
  ]
}
