{
  "contract": "morphogen.organism.v1",
  "key": "organism:hive",
  "name": "Hive",
  "cells": [
    { "id": "src", "kind": "input", "outputs": { "task": "text" } },
    {
      "id": "writer",
      "kind": "agent",
      "inputs": { "task": "text" },
      "prompt": "Emit candidate organism manifests under manifests.",
      "output": {
        "kind": "json",
        "schema": {
          "type": "object",
          "required": ["manifests"],
          "properties": { "manifests": { "type": "array" } }
        }
      }
    },
    {
      "id": "field",
      "kind": "const",
      "outputs": { "f": { "type": "text", "value": "manifests" } }
    },
    { "id": "list", "kind": "fn", "fn": "pick.v1" },
    {
      "id": "swarm",
      "kind": "each",
      "manifest": "sha256:d464e00bbfc7306f23edb6026a0a3e4fc30776dfc0fb2b44b08b5f4f29c2ceff",
      "over": "m",
      "maxItems": 4
    },
    {
      "id": "judge",
      "kind": "agent",
      "inputs": { "cands": "json" },
      "prompt": "Pick the best candidate organism by its outputs.",
      "output": { "kind": "text" }
    }
  ],
  "edges": [
    { "from": { "cell": "src", "port": "task" }, "to": { "cell": "writer", "port": "task" } },
    { "from": { "cell": "writer", "port": "out" }, "to": { "cell": "list", "port": "record" } },
    { "from": { "cell": "field", "port": "f" }, "to": { "cell": "list", "port": "field" } },
    { "from": { "cell": "list", "port": "value" }, "to": { "cell": "swarm", "port": "m" } },
    { "from": { "cell": "swarm", "port": "result" }, "to": { "cell": "judge", "port": "cands" } }
  ]
}
