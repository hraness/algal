{
  "contract": "morphogen.organism.v1",
  "key": "organism:consent",
  "name": "Consent",
  "cells": [
    { "id": "src", "kind": "input", "outputs": { "task": "text" } },
    {
      "id": "writer",
      "kind": "agent",
      "inputs": { "task": "text" },
      "prompt": "Write an organism manifest that asks approval before acting.",
      "output": { "kind": "json", "schema": { "type": "object" } }
    },
    {
      "id": "args",
      "kind": "const",
      "outputs": { "a": { "type": "json", "value": { "q": "what is 2+2?" } } }
    },
    { "id": "run", "kind": "spawn" }
  ],
  "edges": [
    { "from": { "cell": "src", "port": "task" }, "to": { "cell": "writer", "port": "task" } },
    { "from": { "cell": "writer", "port": "out" }, "to": { "cell": "run", "port": "manifest" } },
    { "from": { "cell": "args", "port": "a" }, "to": { "cell": "run", "port": "args" } }
  ]
}
