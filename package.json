{
  "name": "@hraness/algal",
  "version": "0.2.0",
  "description": "ALGAL: a language for growing agent programs, with typed workflows, bounded model execution, and replayable evidence. Bun-only TypeScript package: exports and bin point at .ts sources (no build step, no Node.js support).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/algal.git"
  },
  "homepage": "https://algal.computer",
  "bugs": {
    "url": "https://github.com/hraness/algal/issues"
  },
  "license": "MIT",
  "type": "module",
  "private": false,
  "exports": {
    ".": "./index.ts",
    "./manifest": "./src/contract.ts",
    "./contract": "./src/contract.ts",
    "./capabilities": "./src/capabilities.ts",
    "./mailbox": "./src/mailbox.ts"
  },
  "bin": {
    "algal": "./cli.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "index.ts",
    "cli.ts",
    "src",
    "!src/**/*.test.ts",
    "!src/fixtures",
    "spec",
    "examples",
    "!examples/**/*.test.ts",
    "!examples/**/test_*.py",
    "!examples/**/memory-fixtures",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p site/tsconfig.json",
    "lint": "eslint .",
    "test": "bun test --timeout 20000",
    "check": "bun run typecheck && bun run lint && bun run test && bun run docs:check && bun run build:site",
    "docs:diagrams": "bun scripts/docs-diagrams.ts",
    "docs:check": "bun scripts/docs-diagrams.ts --check",
    "build:site": "bun site/build.ts",
    "generate:og": "bun site/generate-og.tsx",
    "cli": "bun cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@hraness/design-kit": "github:hraness/design-kit#v0.11.1",
    "@hraness/ui": "github:hraness/ui#v0.5.16",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.6.0",
    "@hugeicons/core-free-icons": "4.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "^1.2.0",
    "eslint": "^9.13.0",
    "react": "19.2.3",
    "satori": "0.33.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agentic-workflows",
    "llm",
    "typed-graph",
    "replay",
    "hraness"
  ]
}
