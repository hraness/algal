{
  "name": "@hraness/morphogen",
  "version": "0.1.0",
  "description": "Typed, replayable workflow organisms: deterministic structure, bounded agent cells, replayable receipts.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "exports": {
    ".": "./index.ts",
    "./manifest": "./src/manifest.ts",
    "./contract": "./src/contract.ts"
  },
  "bin": {
    "morphogen": "./cli.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "index.ts",
    "cli.ts",
    "src",
    "spec",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build:site",
    "build:site": "bun site/build.ts",
    "cli": "bun cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/bun": "^1.2.0",
    "eslint": "^9.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agentic-workflows",
    "llm",
    "typed-graph",
    "replay",
    "hraness"
  ]
}
