{
  "name": "@hraness/algal",
  "version": "0.2.0",
  "description": "ALGAL is a programming language and VM for AI agent programs that wait for approval and leave receipts you can replay. Bun-only TypeScript package: exports and bin point at .ts sources (no build step, no Node.js support).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/algal.git"
  },
  "homepage": "https://algal.computer",
  "bugs": {
    "url": "https://github.com/hraness/algal/issues"
  },
  "license": "MIT",
  "type": "module",
  "private": false,
  "exports": {
    ".": "./index.ts",
    "./manifest": "./src/contract.ts",
    "./contract": "./src/contract.ts",
    "./expr": "./src/expr.ts",
    "./algal_expr.wasm": "./src/algal_expr.wasm",
    "./capabilities": "./src/capabilities.ts",
    "./mailbox": "./src/mailbox.ts",
    "./mailbox-core": "./src/mailbox-core.ts",
    "./mailbox-idb": "./src/mailbox-idb.ts",
    "./host-events-core": "./src/host-events-core.ts",
    "./host-events-idb": "./src/host-events-idb.ts",
    "./application-core": "./src/application-core.ts",
    "./application-storage": "./src/application-storage.ts",
    "./application-browser-storage": "./src/application-browser-storage.ts",
    "./marketing-core": "./examples/malleable-site/core.ts",
    "./browser-grow": "./examples/browser-grow/controller.ts",
    "./triage-core": "./examples/local-triage/core.ts",
    "./triage-contract": "./examples/local-triage/contract.ts",
    "./browser-triage": "./examples/browser-triage/controller.ts",
    "./marketing-manifests": "./examples/malleable-site/surface-manifests.ts",
    "./marketing-surface": "./examples/malleable-site/surface.ts",
    "./application-contract": "./src/application-contract.ts",
    "./application-adaptation": "./src/application-adaptation.ts",
    "./application-memory": "./src/application-memory.ts",
    "./application-restoration": "./src/application-restoration.ts",
    "./bundle": "./src/bundle.ts",
    "./registry": "./src/registry.ts",
    "./run": "./src/run.ts",
    "./store-memory": "./src/store-memory.ts",
    "./verify": "./src/verify.ts",
    "./decisions": "./src/decisions.ts",
    "./effects": "./src/effects.ts",
    "./digest": "./src/digest.ts",
    "./values": "./src/values.ts",
    "./errors": "./src/errors.ts",
    "./store-contract": "./src/store-contract.ts",
    "./process": "./src/process.ts",
    "./process-evidence": "./src/process-evidence.ts",
    "./runtime-journal-contract": "./src/runtime-journal-contract.ts",
    "./source": "./src/source.ts",
    "./source-errors": "./src/source-errors.ts",
    "./task": "./src/task.ts",
    "./task-parameters": "./src/task-parameters.ts",
    "./task-optimizer": "./src/task-optimizer.ts",
    "./task-artifact": "./src/task-artifact.ts",
    "./task-workflow": "./src/task-workflow.ts",
    "./host-contract": "./src/host-contract.ts",
    "./improve": "./src/improve.ts",
    "./graph": "./src/graph.ts",
    "./tools": "./src/tools.ts",
    "./tool-context": "./src/tool-context.ts",
    "./habitat-link": "./src/habitat-link.ts",
    "./habitat-link-authority": "./src/habitat-link-authority.ts",
    "./habitat-link-host": "./src/habitat-link-host.ts",
    "./habitat-link-socket": "./src/habitat-link-socket.ts"
  },
  "bin": {
    "algal": "./cli.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "index.ts",
    "cli.ts",
    "src",
    "!src/**/*.test.ts",
    "!src/fixtures",
    "spec",
    "examples",
    "!examples/**/*.test.ts",
    "!examples/**/test_*.py",
    "!examples/**/memory-fixtures",
    "docs",
    "README.md",
    "LICENSE",
    "!examples/**/target",
    "!examples/**/dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p site/tsconfig.json && tsc --noEmit -p site/tsconfig.inference-worker.json",
    "lint": "eslint .",
    "test": "bun test --timeout 20000",
    "check:hf": "python3 -B hf/stage.py && python3 -B hf/test_stage.py",
    "check": "bun run typecheck && bun run lint && bun run test && bun run docs:check && bun run build:site",
    "docs:diagrams": "bun scripts/docs-diagrams.ts",
    "docs:check": "bun scripts/docs-diagrams.ts --check",
    "build:site": "bun site/build.ts",
    "generate:icons": "bun site/generate-icons.ts",
    "cli": "bun cli.ts",
    "launch:kit": "bun site/scripts/write-social-kit.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@hraness/design-kit": "github:hraness/design-kit#v0.32.0",
    "@hraness/desktop-foundation": "https://github.com/hraness/desktop-foundation/releases/download/v0.8.0/hraness-desktop-foundation-0.8.0.tgz",
    "@hraness/posthog": "https://github.com/hraness/posthog/releases/download/v0.3.7/hraness-posthog-0.3.7.tgz",
    "@hraness/ui": "github:hraness/ui#v0.5.18",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.13.0",
    "@hugeicons/core-free-icons": "4.3.0",
    "@mlc-ai/web-llm": "0.2.85",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "^1.2.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.13.0",
    "playwright-core": "1.63.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "satori": "0.33.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agentic-workflows",
    "llm",
    "typed-graph",
    "replay",
    "hraness"
  ]
}
