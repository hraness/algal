{
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "site/dist",
    "site/appearance.ts",
    "site/client.ts",
    "site/viewer.ts",
    "site/living.ts",
    "site/workbench.ts",
    "site/grow.ts",
    "site/browser-inference.ts",
    "site/browser-inference-worker.ts",
    "examples/malleable-site/renderers/target",
    "examples/malleable-site/renderers/dist",
    "dist",
    ".algal",
    "examples/local-triage/renderers/target",
    "examples/local-triage/dist"
  ]
}
