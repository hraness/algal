{
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["bun"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "site/dist", "site/appearance.ts", "site/client.ts", "site/viewer.ts", "site/living.ts", "examples/malleable-site/renderers/target", "examples/malleable-site/renderers/dist", "dist", ".algal"]
}
