{
  "framework": null,
  "buildCommand": "bun run build:site",
  "installCommand": "bun install --frozen-lockfile --ignore-scripts",
  "outputDirectory": "site/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "algal.dev" }],
      "destination": "https://algal.computer/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.algal.dev" }],
      "destination": "https://algal.computer/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.algal.computer" }],
      "destination": "https://algal.computer/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "algal.vercel.app" }],
      "destination": "https://algal.computer/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "algal-hraness.vercel.app" }],
      "destination": "https://algal.computer/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "algal-teal.vercel.app" }],
      "destination": "https://algal.computer/$1",
      "permanent": true
    }
  ]
}
