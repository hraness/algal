{
  "framework": null,
  "buildCommand": "bun run build:site",
  "installCommand": "bun install --frozen-lockfile --ignore-scripts",
  "outputDirectory": "site/dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "algal.dev" }],
      "destination": "https://algal.computer/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.algal.dev" }],
      "destination": "https://algal.computer/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.algal.computer" }],
      "destination": "https://algal.computer/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "algal.vercel.app" },
        { "type": "host", "value": "algal-hraness.vercel.app" },
        { "type": "host", "value": "algal-teal.vercel.app" }
      ],
      "destination": "https://algal.computer/$1",
      "permanent": true
    }
  ]
}
